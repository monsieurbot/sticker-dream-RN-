{
  "expo": {
    "name": "Sticker Dream",
    "slug": "sticker-dream",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "stickerdream",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFE5F1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stickerdream.app",
      "appleTeamId": "5F3F3Q9Y2Q",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sticker Dream needs microphone access to record your sticker descriptions",
        "NSBluetoothAlwaysUsageDescription": "Sticker Dream needs Bluetooth access to print to your thermal printer",
        "NSBluetoothPeripheralUsageDescription": "Sticker Dream needs Bluetooth access to connect to your thermal printer",
        "NSLocalNetworkUsageDescription": "Sticker Dream needs local network access to connect to the development server",
        "NSBonjourServices": ["_http._tcp"],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.781487573862-p1gi5tdn1hhj12j2erdpu9euh8ajr1cm"
            ]
          }
        ]
      },
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFE5F1"
      },
      "package": "com.stickerdream.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN"
      ],
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Sticker Dream to access your microphone to record voice descriptions"
        }
      ],
      [
        "@react-native-google-signin/google-signin"
      ],
      "./plugins/withWhisper.js",
      "./plugins/withBluetoothPrinter.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
